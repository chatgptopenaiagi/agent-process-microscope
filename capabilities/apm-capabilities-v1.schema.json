{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APM capability inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "application_version",
    "scope",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "application_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "purpose",
          "version_compatibility",
          "implementation",
          "public_entry_points",
          "inputs",
          "outputs",
          "dependencies",
          "evidence_sources",
          "limitations",
          "permissions",
          "safety_boundaries",
          "tests",
          "implementation_status",
          "verification_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^apm\\.[a-z]+\\.[a-z]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "version_compatibility": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "implementation": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "public_entry_points": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "dependencies": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "evidence_sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "safety_boundaries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "implementation_status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "enum": [
              "IMPLEMENTED",
              "EXPERIMENTAL",
              "PLANNED"
            ]
          },
          "verification_status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "enum": [
              "TESTED",
              "UNVERIFIED"
            ]
          }
        }
      }
    }
  }
}
